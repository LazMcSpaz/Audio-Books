# Keep the pipeline folder convention tracked (READMEs) but don't commit the
# actual book files / generated chunks — those are per-book working data.
incoming/*
chunks/*
final/*
!incoming/README.md
!chunks/README.md
!final/README.md

# Worker / Wrangler — never commit local secrets or build artifacts
.dev.vars
.wrangler/
node_modules/
dist/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
